# ============================================================
# Children's Lunch RAG System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit it.
#
# Provider resolution order (automatic):
#   1. Groq  (if GROQ_API_KEY is set and non-empty)
#   2. Ollama (if Groq key absent AND Ollama is running locally)
#   3. --mock flag (no real inference, for testing only)
#
# Anthropic is NOT used anywhere in this project.
# ============================================================

# ── GENERATOR MODEL (used for lunch recommendations) ───────────────────────
# Groq (cloud, free tier) — get key at https://console.groq.com
GROQ_API_KEY=

# Generator model — fast, capable for structured JSON output.
# (The previous default, llama-3.1-8b-instant, was shut down by Groq on
#  2026-08-16 along with llama-3.3-70b-versatile.)
GROQ_MODEL=qwen/qwen3.6-27b

# Reasoning budget. Left unset on purpose: llm_provider derives it from the
# model id, because the accepted values are a property of the model and do not
# overlap (qwen3: none|default — reasoning off, since generation fills a JSON
# template and thinking tokens would eat the menus' LLM_MAX_TOKENS budget;
# gpt-oss: low|medium|high; anything else: no parameter sent at all).
# Uncomment ONLY to override, and check the value against the model you set —
# a wrong one is a 400 on every call.
# GROQ_REASONING_EFFORT=none

# ── JUDGE MODEL (used for LLM-as-judge evaluation) ─────────────────────────
# IMPORTANT: The judge must come from a DIFFERENT MODEL FAMILY than the
# generator (requirement 6 of this project). Qwen generates, an OpenAI
# open-weight model judges. Size alone is not the point: two models of one
# lineage share pretraining data and RLHF conventions, so a same-family judge
# still rewards its own house style however much larger it is.
GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# Also derived from the model id — "low" for gpt-oss, which is its lowest
# setting ("none" is not in its vocabulary) and keeps hidden reasoning inside
# the 450-token judge budget below. Uncomment only to override.
# GROQ_JUDGE_REASONING_EFFORT=low

# ── OLLAMA (local, no API key needed) ──────────────────────────────────────
# Install from: https://ollama.com
# Then: ollama pull llama3.2   (generator)
#       ollama pull llama3.1   (judge, larger model for evaluation)
# Start: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_JUDGE_MODEL=llama3.1

# Per-call timeout for Ollama, in seconds. Much larger than the Groq default:
# a 3B model on CPU can take minutes for one generation where the cloud takes
# seconds. Before this existed there was NO timeout on a local call, so a model
# thrashing against a full page file blocked the run indefinitely.
OLLAMA_TIMEOUT_SECS=300

# Constrain Ollama sampling to valid JSON. Both roles here ask for JSON and parse
# it, and a small local model is much worse at holding that format unaided than
# the cloud one: run 20260820_100542 (llama3.2, 3B) recorded 26 parse failures
# across 16 cases -- every error in the run -- including replies that returned
# Python source code instead of the object. Set false only to inspect raw output.
OLLAMA_JSON_MODE=true

# MEMORY. Ollama keeps a model resident for ~5 minutes after its last call, so
# the generator and the judge can be in RAM at once: llama3.2 (2.0 GB) plus
# llama3.1 (4.9 GB) needs ~7 GB. On a machine with less, the allocation fails
# inside Ollama's native backend and the run dies with `Segmentation fault`,
# naming nothing. run_all.py evicts the generator before judging and warns at
# startup when the configured pair looks too large. If it still dies, set a
# smaller judge (OLLAMA_JUDGE_MODEL=llama3.2) or pass --no-judge.
#
# Note also that llama3.1 and llama3.2 are the SAME family, so an all-Ollama run
# does not satisfy the different-family requirement the judge exists to meet --
# see the module docstring in src/llm_provider.py. `mistral` is a different
# family if you have the RAM for it.

# ── LANGSMITH (optional — traces every LangGraph node call) ────────────────
# Get a free key at: https://smith.langchain.com
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=lunch-rag-benchmark

# ── GENERATION SETTINGS ────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
# Groq bills the *reserved* budget, and qwen3.6-27b allows 200k tokens/day
# where the retired llama-3.1-8b-instant allowed 500k. Measured over 18 calls
# across all five case categories: prompts 250–1907 tokens (median 562),
# completions 7–751. At the old 2000 a 30-case run bills 90 x ~2562 = ~231k and
# dies around case 26; at 1200 it bills ~158k and completes, keeping 1.6x
# headroom over the longest menu JSON seen. Raise it only alongside that sum.
LLM_MAX_TOKENS=1200

# ── JUDGE SETTINGS ─────────────────────────────────────────────────────────
# Kept separate from the generator's. Groq charges the *reserved* max_tokens
# against the rate-limit budget, not the tokens actually produced, so a judge
# sharing LLM_MAX_TOKENS=2000 burned ~2081 tokens per one-sentence verdict and
# exhausted its daily cap after ~48 calls. A 30-case run needs ~321.
# 450 fits gpt-oss-120b, whose reply follows hidden reasoning tokens (observed
# completions 198–228): ~581 reserved per call against 200k tokens/day is ~344
# calls — a full run, with no truncation mid-verdict.
JUDGE_MAX_TOKENS=450
# A scorer should not sample.
JUDGE_TEMPERATURE=0.0
# Longest provider-requested backoff worth waiting out mid-run (seconds).
# Per-minute limits clear in seconds; the per-day cap reports ~18 minutes and
# will not refill during the run, so past this the judge pass stops.
JUDGE_MAX_RATE_LIMIT_WAIT=90

# Request timeout and retry budget. Without retries a single transient 429
# mid-benchmark is recorded as a pipeline error and drops that case from the
# metrics, quietly shrinking the sample the run is scored on.
LLM_TIMEOUT_SECS=60
LLM_MAX_RETRIES=4

# ── GUARDRAIL ──────────────────────────────────────────────────────────────
# Share of the daily nutrient maximum allowed in one lunch.
# Run `python eval/check_data_quality.py` before raising this: on the current
# corpus the binding constraint is unreliable sugar data, not this fraction,
# and raising it weakens a real safety limit to work around a data defect.
LUNCH_NUTRITION_FRACTION=0.40

# What happens when a recipe is over that ceiling:
#   advisory (default) — recorded as a warning and passed to the generator
#   hard               — the recipe is rejected, as an allergen hit is
#   off                — band ceilings are not checked
#
# Advisory is the default because a hard ceiling here rejects safe food for two
# reasons that have nothing to do with the child. The corpus field is `sugars_g`
# (TOTAL sugars) and the guideline is `free_sugars_g_day_max` (FREE sugars), so
# fruit and dairy are charged sugar they do not owe; and
# `python eval/check_data_quality.py` finds savoury dishes carrying 44 g and
# round placeholder figures repeated across unrelated recipes. Between them they
# rejected 21 of 29 recipes at age 7-10 on sugar alone, before any allergen was
# considered — 161 of 199 pre-filter rejections in the 2026-08-18 run.
#
# ALLERGENS ARE NEVER ADVISORY. This setting governs sugar and salt only.
# A ceiling set per child (max_sugar_g_override / max_salt_g_override on
# ChildProfile) is enforced in every mode.
#
# Set this to `hard` once the corpus carries free-sugar figures that
# check_data_quality.py passes clean.
NUTRITION_GATE=advisory

# What a diet-requirement miss does: reject (`hard`), warn (`advisory`), or
# nothing (`off`). Covers vegetarian / vegan / pescatarian / halal / kosher,
# declared per child via `diet_requirements` (or stated in cultural_context,
# which is also read).
#
# Defaults to `hard` where NUTRITION_GATE defaults to `advisory`, because the
# data is sound: all 29 recipes carry `diet_tags`, and the exclusions are read
# from the same ingredient list the allergen scan trusts. A vegetarian profile
# served chicken is a plain failure, not a judgement call about food quality.
#
# For halal and kosher this enforces INGREDIENT EXCLUSIONS ONLY -- pork and its
# derivatives, plus shellfish for kosher. Certification, slaughter method and
# preparation separation are not represented in the corpus and are not verified;
# the guardrail attaches a warning saying so on every such check.
DIET_GATE=hard

# ── RETRIEVAL ──────────────────────────────────────────────────────────────
# Semantic retrieval uses neural sentence embeddings. There is no on/off flag:
# this is the only embedding backend. The first run downloads the model
# (~90 MB) to ~/.cache/huggingface/ and reuses it afterwards.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cross-encoder reranking of the RRF-fused candidates. On by default.
# Set to false to skip the stage and keep RRF fusion order.
USE_CROSS_ENCODER_RERANKER=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# How many candidates survive reranking and reach the symbolic gates / LLM.
RERANK_TOP_K=9
