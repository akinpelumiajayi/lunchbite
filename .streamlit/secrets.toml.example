# Streamlit secrets template -- copy the keys, not this file.
#
# Locally the app reads .env and needs none of this. This exists for Streamlit
# Community Cloud, where there is no .env (it is gitignored, and holds the Groq
# key). Paste the contents into the app's Settings -> Secrets box in the
# Streamlit Cloud console; the app picks them up on the next restart.
#
# app/lunchbite/bootstrap.py copies every flat key here into os.environ, which
# is where everything under src/ reads its configuration from. So the names
# below are exactly the .env names -- one list, not two.
#
# The VALUES have to track .env as well, not just the names. This file is meant
# to be pasted verbatim with only the key substituted, so a value that drifts
# from .env does not announce itself -- it produces a deployed app that
# generates under different parameters than every local run and every benchmark
# in the report, while looking correct. Change one here, change it there.

# ── Required: the LLM provider ───────────────────────────────────────────────
# Free key from https://console.groq.com. Without it the app still starts and
# the rule-based arm still works, but no arm that asks a model will run.
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "qwen/qwen3.6-27b"

# ── Retrieval models ─────────────────────────────────────────────────────────
# Both download from Hugging Face on first run and are cached on the container.
HF_EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
CROSS_ENCODER_MODEL = "cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANK_TOP_K = "9"

# Cross-encoder reranking is a second ~90 MB model held in memory alongside the
# embedding model. It is the first thing to turn off if the deployed app is
# killed for exceeding its memory limit: retrieval falls back to RRF fusion
# order, which is a real quality loss but a running app rather than a dead one.
USE_CROSS_ENCODER_RERANKER = "true"

# ── Generation ───────────────────────────────────────────────────────────────
LLM_TEMPERATURE = "0.1"
LLM_MAX_TOKENS = "1200"

# ── Optional: LangSmith tracing ──────────────────────────────────────────────
# Leave out entirely unless you want deployed runs traced.
# LANGSMITH_API_KEY = "lsv2_..."
# LANGCHAIN_PROJECT = "lunchbite-deployed"

# ── Not applicable in the cloud ──────────────────────────────────────────────
# OLLAMA_* is deliberately absent. Ollama runs on localhost, and the container
# has no localhost Ollama; llm_provider probes for it, fails fast, and reports
# "not reachable". Setting OLLAMA_BASE_URL here would only make that probe slow.
